#!/usr/bin/env bash
# ============================================================
# edBisync - Bidirectional sync lokal ↔ Google Drive (Optimized)
# Path  : ~/.local/bin/edBisync
# Lokal : /home/tobdeuc/GoogleDrive/8bpCued411/
# Remote: 8bpCued411:
# ============================================================

# --- KONFIGURASI ---
LOCAL_PATH="/home/tobdeuc/GoogleDrive/8bpCued411/"
REMOTE="8bpCued411:"
REMOTE_NAME="8bpCued411"
EXCLUDE_FLAGS=("--exclude" "_BACKUP_remote-only/**")
DATA_DIR="$HOME/.local/share/edBisync"
LOCK_FILE="$DATA_DIR/edBisync.lock"
LOG_FILE="$DATA_DIR/edBisync.log"

# --- TUNING PERFORMANCE & KEAMANAN (OPTIMIZED) ---
# --transfers 1 : Upload/download satu per satu file (sequential)
# --checkers 4   : Mencegah limit API Google Drive (terutama shared client_id)
# --stats=2s     : Update info progress setiap 2 detik
RCLONE_OPTS=("--transfers" "1" "--checkers" "4" "--stats" "2s" "--human-readable")

# --- WARNA TERMINAL ---
RED='\033[0;31m'; GREEN='\033[0;32m'; YELLOW='\033[1;33m'
BLUE='\033[0;34m'; CYAN='\033[0;36m'; BOLD='\033[1m'
DIM='\033[2m'; NC='\033[0m'

ok()   { echo -e "${GREEN}✅ $*${NC}"; }
warn() { echo -e "${YELLOW}⚠️  $*${NC}"; }
fail() { echo -e "${RED}❌ $*${NC}"; }
info() { echo -e "${BLUE}ℹ️  $*${NC}"; }
head_(){ echo -e "\n${BOLD}${CYAN}══════════════════════════════════════${NC}"; echo -e "${BOLD}${CYAN}  $*${NC}"; echo -e "${BOLD}${CYAN}══════════════════════════════════════${NC}"; }

# --- FUNGSI DASAR ---
notify() {
    command -v notify-send &>/dev/null && \
        notify-send -u "${3:-normal}" "edBisync" "$1: $2" 2>/dev/null || true
}

log_msg() {
    echo "[$(date '+%Y-%m-%d %H:%M:%S')] [$1] $2" >> "$LOG_FILE"
}

acquire_lock() {
    if [ -f "$LOCK_FILE" ]; then
        local pid
        pid=$(cat "$LOCK_FILE" 2>/dev/null)
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            fail "edBisync sedang berjalan (PID: $pid)"
            warn "Jika yakin tidak ada proses: rm $LOCK_FILE"
            exit 1
        fi
        rm -f "$LOCK_FILE"
    fi
    echo $$ > "$LOCK_FILE"
}

cleanup() { rm -f "$LOCK_FILE"; }
trap cleanup EXIT

check_connection() {
    head_ "Koneksi"
    if rclone about "$REMOTE" &>/dev/null; then
        ok "Google Drive terhubung"
        return 0
    else
        fail "Gagal terhubung ke Google Drive"
        notify "Gagal" "Koneksi ke Google Drive gagal" "critical"
        return 1
    fi
}

is_first_run() {
    local count
    count=$(find "$HOME/.cache/rclone/bisync" \
        -name "*8bpCued411*.path1.lst" \
        2>/dev/null | wc -l)
    [ "$count" -eq 0 ]
}

show_config() {
    echo -e "  ${DIM}Lokal  :${NC} $LOCAL_PATH"
    echo -e "  ${DIM}Remote :${NC} $REMOTE"
    echo -e "  ${DIM}Exclude:${NC} _BACKUP_remote-only/**"
    echo -e "  ${DIM}Mode   :${NC} transfers=1, checkers=4 (Sequential Upload)"
    echo ""
}

# ============================================================
# MODE: PREVIEW (default)
# ============================================================
do_preview() {
    head_ "PREVIEW (Dry-Run)"
    info "Mode ini TIDAK mengubah file apapun"
    show_config
    check_connection || exit 1

    local extra=()
    if is_first_run; then
        warn "Cache belum ada → otomatis --resync"
        extra+=("--resync")
    fi

    head_ "Hasil Preview"
    rclone bisync "$LOCAL_PATH" "$REMOTE" \
        "${EXCLUDE_FLAGS[@]}" "${RCLONE_OPTS[@]}" "${extra[@]}" \
        --dry-run --verbose \
        2>&1 | tee -a "$LOG_FILE"
    local rc=${PIPESTATUS[0]}

    echo ""
    if [ $rc -eq 0 ]; then
        ok "Preview selesai."
        info "Jika aman, jalankan: ${BOLD}edBisync sync${NC}"
        notify "Preview" "Selesai. Cek terminal."
    else
        fail "Preview gagal (code: $rc)"
        notify "Preview Gagal" "Cek terminal" "critical"
    fi
}

# ============================================================
# MODE: SYNC
# ============================================================
do_sync() {
    head_ "SYNC (Bisync Rutin)"
    show_config
    check_connection || exit 1

    if is_first_run; then
        fail "Cache belum ada! Jalankan dulu: ${BOLD}edBisync resync${NC}"
        exit 1
    fi

    head_ "Memulai Sync"
    rclone bisync "$LOCAL_PATH" "$REMOTE" \
        "${EXCLUDE_FLAGS[@]}" "${RCLONE_OPTS[@]}" \
        --progress --verbose \
        2>&1 | tee -a "$LOG_FILE"
    local rc=${PIPESTATUS[0]}

    echo ""
    if [ $rc -eq 0 ]; then
        ok "Bisync berhasil!"
        notify "Sync" "Berhasil ✅"
    else
        fail "Bisync gagal (code: $rc)"
        notify "Sync Gagal" "Cek terminal" "critical"
    fi
}

# ============================================================
# MODE: RESYNC
# ============================================================
do_resync() {
    head_ "RESYNC (Inisialisasi / Reset)"
    warn "Path1 (lokal) = sumber kebenaran"
    warn "Kedua sisi akan dipaksa sama!"
    show_config
    check_connection || exit 1

    echo -e "${BOLD}${YELLOW}Lanjut? (y/N):${NC} "
    read -r confirm
    if [[ ! "$confirm" =~ ^[Yy]$ ]]; then
        info "Dibatalkan."
        exit 0
    fi

    head_ "Memulai Resync"
    rclone bisync "$LOCAL_PATH" "$REMOTE" \
        "${EXCLUDE_FLAGS[@]}" "${RCLONE_OPTS[@]}" \
        --resync --progress --verbose \
        2>&1 | tee -a "$LOG_FILE"
    local rc=${PIPESTATUS[0]}

    echo ""
    if [ $rc -eq 0 ]; then
        ok "Resync berhasil!"
        notify "Resync" "Berhasil ✅"
    else
        fail "Resync gagal (code: $rc)"
        notify "Resync Gagal" "Cek terminal" "critical"
    fi
}

# ============================================================
# MODE: VERIFY
# ============================================================
do_verify() {
    head_ "VERIFY (Cek Sinkronisasi)"
    show_config
    check_connection || exit 1

    if is_first_run; then
        fail "Cache belum ada. Belum pernah sync."
        exit 1
    fi

    head_ "Mengecek..."
    local output
    output=$(rclone bisync "$LOCAL_PATH" "$REMOTE" \
        "${EXCLUDE_FLAGS[@]}" "${RCLONE_OPTS[@]}" \
        --dry-run --verbose 2>&1)
    local rc=$?

    echo "$output" | tee -a "$LOG_FILE"
    echo ""

    local skipped
    skipped=$(echo "$output" | grep -c "Skipped" || true)

    if [ $rc -eq 0 ] && [ "$skipped" -eq 0 ]; then
        ok "LOKAL DAN REMOTE SUDAH SINKRON!"
        notify "Verify" "Sudah sinkron ✅"
    else
        warn "Ada $skipped perbedaan."
        info "Preview:  ${BOLD}edBisync${NC}"
        info "Sync:     ${BOLD}edBisync sync${NC}"
        notify "Verify" "Ada perbedaan" "normal"
    fi
}

# ============================================================
# MODE: CHECK
# ============================================================
do_check() {
    head_ "CHECK (Byte-Level)"
    warn "Bisa LAMBAT untuk file besar (film 7.2GB)"
    show_config
    check_connection || exit 1

    head_ "Memulai Check"
    rclone check "$LOCAL_PATH" "$REMOTE" \
        "${EXCLUDE_FLAGS[@]}" \
        --progress --stats=5s \
        2>&1 | tee -a "$LOG_FILE"
    local rc=${PIPESTATUS[0]}

    echo ""
    if [ $rc -eq 0 ]; then
        ok "Semua file IDENTIK!"
        notify "Check" "Semua identik ✅"
    else
        warn "Ada perbedaan isi file."
        notify "Check" "Ada perbedaan" "normal"
    fi
}

# ============================================================
# USAGE
# ============================================================
usage() {
    echo ""
    echo -e "${BOLD}edBisync${NC} — Sync 2 arah: lokal ↔ Google Drive"
    echo ""
    echo -e "${BOLD}Perintah:${NC}"
    echo -e "  ${CYAN}edBisync${NC}          Preview (dry-run, aman, default)"
    echo -e "  ${CYAN}edBisync sync${NC}     Jalankan sync sungguhan (Sequential)"
    echo -e "  ${CYAN}edBisync resync${NC}   Inisialisasi pertama / reset"
    echo -e "  ${CYAN}edBisync verify${NC}   Cek apakah sudah sinkron"
    echo -e "  ${CYAN}edBisync check${NC}    Bandingkan byte (lambat)"
    echo -e "  ${CYAN}edBisync help${NC}     Bantuan ini"
    echo ""
    echo -e "${BOLD}Path:${NC}"
    echo -e "  Lokal : $LOCAL_PATH"
    echo -e "  Remote: $REMOTE"
    echo -e "  Log   : $LOG_FILE"
    echo ""
}

# ============================================================
# MAIN
# ============================================================
mkdir -p "$DATA_DIR"
acquire_lock
log_msg "START" "arg=${1:-preview}"

case "${1:-}" in
    sync)       do_sync ;;
    resync)     do_resync ;;
    verify)     do_verify ;;
    check)      do_check ;;
    ""|preview) do_preview ;;
    help|-h|--help) usage ;;
    *)
        fail "Argumen tidak dikenal: $1"
        usage
        exit 1
        ;;
esac

log_msg "END" "arg=${1:-preview}"
